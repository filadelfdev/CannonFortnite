; CfSpoof — HWID spoof driver install INF
;
; Service-style install, non-PnP, type = kernel.
;   sc create CfSpoof type= kernel start= demand binPath= path\to\spoof.sys
;   sc start  CfSpoof
;
; Attribution: Built by Olivia — https://discord.gg/ojailbreaks

[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%ManufacturerName%
DriverVer=11/09/2026,1.0.0.0
CatalogFile=spoof.cat
PnpLockDown=1

[DestinationDirs]
DefaultDestDir = 12

[DefaultInstall.NTamd64]
CopyFiles = DriverFiles

[DefaultInstall.NTamd64.Services]
AddService = CfSpoof,0x00000002,CfSpoofService

[CfSpoofService]
DisplayName   = %ServiceName%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\spoof.sys

[DriverFiles]
spoof.sys

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
spoof.sys = 1

[Strings]
ManufacturerName = "CF"
ServiceName      = "CfSpoof"
DiskName         = "CfSpoof Install Disk"
